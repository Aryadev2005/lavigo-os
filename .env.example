# Copy to .env and adjust. docker-compose.yml already has dev defaults for the
# infrastructure values, so an empty .env works for local development.
APP_URL=http://localhost:3000
NODE_ENV=development
TZ=Asia/Kolkata
DATABASE_URL=postgresql://lavigo:lavigo@postgres:5432/lavigo
REDIS_URL=redis://redis:6379
# openssl rand -base64 32 (required, ≥ 32 chars, in production)
AUTH_SECRET=change-me
S3_ENDPOINT=http://minio:9000
# Endpoint browsers use for presigned download URLs (empty = S3_ENDPOINT)
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=ap-south-1
S3_BUCKET=lavigo
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio12345
SMTP_URL=smtp://mailpit:1025
MAIL_FROM="Lavigo Travel <noreply@lavigo.in>"

# Providers. Empty in development = use the built-in fake. Required in production.
META_APP_SECRET=
# set to the current Graph API version, e.g. from the Meta dashboard
GRAPH_API_VERSION=
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
WA_VERIFY_TOKEN=
IG_ACCOUNT_ID=
IG_ACCESS_TOKEN=
FEATURE_INSTAGRAM=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PUBLIC_SITE_HOST=lavigo.in
IRCTC_ARP_DAYS=60
SENTRY_DSN=
LOG_LEVEL=info

# Seed only. Empty = a random password is generated and printed by `make seed`.
SEED_OWNER_PASSWORD=
SEED_STAFF_PASSWORD=
SEED_OWNER_PHONE=+919800000001
