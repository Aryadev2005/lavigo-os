{
  "name": "lavigo-os",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": ">=22.18.0 <23"
  },
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build && pnpm build:worker",
    "build:web": "next build",
    "build:worker": "tsup",
    "start": "next start",
    "worker": "node dist/worker.js",
    "worker:dev": "tsx watch --clear-screen=false src/worker/index.ts",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "tsx prisma/seed.ts",
    "job": "tsx scripts/run-job.ts",
    "postinstall": "prisma generate",
    "extract-assets": "tsx scripts/extract-demo-assets.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1178.0",
    "@aws-sdk/s3-request-presigner": "3.1178.0",
    "@node-rs/argon2": "2.2.2",
    "@prisma/client": "6.19.3",
    "@react-pdf/renderer": "4.9.2",
    "bullmq": "5.81.6",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "date-fns-tz": "3.2.0",
    "ioredis": "5.11.1",
    "lucide-react": "1.81.0",
    "next": "16.4.6",
    "next-auth": "5.0.0-beta.32",
    "nodemailer": "7.0.13",
    "pdfkit": "0.21.0",
    "pino": "10.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.5",
    "@types/node": "22.20.7",
    "@types/nodemailer": "8.0.2",
    "@types/react": "19.3.3",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "prisma": "6.19.3",
    "tailwindcss": "4.3.5",
    "tsup": "9.0.0",
    "tsx": "4.23.15",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vitest": "5.1.2"
  }
}
