# Production env for docker-compose.prod.yml. Copy to .env.prod (git-ignored) and fill in.
# The app refuses to boot in production if a provider key below is missing (unless DEMO_FAKES=true).

# ── site ──
SITE_ADDRESS=os.lavigo.in                 # DNS A record → this VPS; Caddy gets the TLS cert
APP_URL=https://os.lavigo.in
ACME_EMAIL=you@lavigo.in                  # Let's Encrypt expiry notices
LAVIGO_IMAGE=ghcr.io/aryadev2005/lavigo-os:latest

# ── secrets ── (generate each with: openssl rand -base64 48)
AUTH_SECRET=
POSTGRES_PASSWORD=

# ── first owner (pnpm seed:prod) ──
SEED_OWNER_EMAIL=
SEED_OWNER_PASSWORD=                      # ≥ 12 characters; change it after first login
SEED_OWNER_NAME=
SEED_OWNER_PHONE=                         # owner's WhatsApp (+91…) for approval alerts

# ── object storage (S3-compatible, private bucket) ──
# AWS S3 Mumbai:      S3_ENDPOINT=            S3_REGION=ap-south-1
# Cloudflare R2:      S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com   S3_REGION=auto
# DigitalOcean Spaces S3_ENDPOINT=https://blr1.digitaloceanspaces.com             S3_REGION=blr1
S3_ENDPOINT=
S3_PUBLIC_ENDPOINT=
S3_REGION=ap-south-1
S3_BUCKET=lavigo-prod
S3_ACCESS_KEY=
S3_SECRET_KEY=
BACKUP_BUCKET=                            # optional; defaults to S3_BUCKET (prefix backups/postgres/)

# ── email ──
SMTP_URL=smtps://user:pass@smtp.example.com:465
MAIL_FROM="Lavigo Travel <noreply@lavigo.in>"

# ── WhatsApp Cloud API (Meta) ──
META_APP_SECRET=
GRAPH_API_VERSION=v21.0
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
WA_VERIFY_TOKEN=                          # any random string; paste the same into Meta's webhook form
FEATURE_INSTAGRAM=false
IG_ACCOUNT_ID=
IG_ACCESS_TOKEN=

# ── Razorpay ── (rzp_test_… keys first; switch to rzp_live_… after the go-live checklist in README)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── features ──
FEATURE_SANDBOX=false                     # true only for a demo: the /sandbox customer simulator
PUBLIC_SITE_HOST=lavigo.in
IRCTC_ARP_DAYS=60
LOG_LEVEL=info
SENTRY_DSN=

# DEMO ONLY. Lets the app run on fake WhatsApp/Razorpay/SMTP/storage when their keys are empty.
# Never set on the real deployment.
# DEMO_FAKES=true
