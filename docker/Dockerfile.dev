# Dev image: Node 22 + pnpm + openssl (Prisma). Source is bind-mounted by compose;
# node_modules and the pnpm store live in named volumes, never on the host tree.
FROM node:22-bookworm-slim

RUN apt-get update \
 && apt-get install -y --no-install-recommends openssl ca-certificates tini git \
 && rm -rf /var/lib/apt/lists/*

ARG PNPM_VERSION=12.23.0
RUN npm install -g pnpm@${PNPM_VERSION} && pnpm --version

ENV PNPM_HOME=/pnpm \
    PNPM_STORE_DIR=/pnpm/store \
    NEXT_TELEMETRY_DISABLED=1 \
    TZ=Asia/Kolkata
RUN mkdir -p /pnpm/store /app/node_modules /app/.next && chown -R node:node /pnpm /app

USER node
WORKDIR /app
RUN pnpm config set store-dir /pnpm/store

ENTRYPOINT ["/usr/bin/tini", "--", "/app/docker/dev-entrypoint.sh"]
CMD ["pnpm", "dev"]
