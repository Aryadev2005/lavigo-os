# Caddy in front of Lavigo OS (docker-compose.prod.yml). Automatic HTTPS for SITE_ADDRESS
# (e.g. os.lavigo.in); SITE_ADDRESS=":80" serves plain HTTP for local production-mode runs.
{
	email {$ACME_EMAIL}
	# No `servers { trusted_proxies … }` block: Caddy trusts NO upstream proxy, so a client-sent
	# X-Forwarded-For is never taken as the client address. The app's login rate limit relies on this.
}

{$SITE_ADDRESS} {
	encode zstd gzip

	# Largest legitimate request: ticket PDFs on confirm (2 × 10 MB) under the 21 MB server-action limit.
	request_body {
		max_size 22MB
	}

	reverse_proxy web:3000 {
		# Overwrite (not append to) whatever the client sent: the app reads the last hop.
		header_up X-Forwarded-For {remote_host}
		header_up X-Real-IP {remote_host}
		# Server-sent events (/api/stream) must not be buffered.
		flush_interval -1
	}

	log {
		output stdout
		format json
	}
}
